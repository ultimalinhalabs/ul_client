# Supabase Auth (identity provider) — the SAME Supabase project as
# ul-platform and ul-console: one human identity across the whole
# ecosystem. Only the public URL and anon key: never the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# UL Platform API base URL (no trailing slash, no /v1 suffix — lib/api/client.ts adds it).
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:4000

# Optional — where the organization opens Na Pista once its access is active (Na Pista Console, no trailing slash).
# Unset = no "Abrir Na Pista" button.
NEXT_PUBLIC_NA_PISTA_CONSOLE_URL=
